{
  "name": "supplycart/settings",
  "description": "Model settings for Laravel",
  "scripts": {
    "analyse": "@php vendor/bin/phpstan analyse --no-progress",
    "lint": "@php vendor/bin/pint",
    "lint:check": "@php vendor/bin/pint --test",
    "test": "@php vendor/bin/phpunit",
    "test:coverage": [
      "@php vendor/bin/phpunit --coverage-clover=.phpunit.cache/coverage.xml",
      "@php scripts/check-coverage.php .phpunit.cache/coverage.xml 85"
    ]
  },
  "require": {
    "php": "^8.5",
    "illuminate/broadcasting": "^13.0",
    "illuminate/cache": "^13.0",
    "illuminate/database": "^13.0",
    "illuminate/queue": "^13.0",
    "illuminate/support": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "Supplycart\\Settings\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Supplycart\\Settings\\Tests\\": "tests"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Supplycart\\Settings\\Providers\\SettingsServiceProvider"
      ]
    }
  },
  "license": "MIT",
  "authors": [
    {
      "name": "Azri Ismail",
      "email": "azri@supplycart.my"
    }
  ],
  "require-dev": {
    "larastan/larastan": "^3.10",
    "laravel/pint": "^1.27",
    "orchestra/canvas": "^11.0",
    "orchestra/testbench": "^11.0",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.5"
  },
  "config": {
    "sort-packages": true
  }
}
